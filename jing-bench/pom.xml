<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.jingproject</groupId>
        <artifactId>jing-project</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>jing-bench</artifactId>

    <properties>
        <jmh.version>1.37</jmh.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <jackson.version>3.2.0</jackson.version>
    </properties>

    <dependencies>
        <!-- jing modules -->
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-marshall</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-marshall-json</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-ffm</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-bindings</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-net</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- annotation processors (compile scope) -->
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-marshall-processor</artifactId>
            <version>${revision}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jingproject</groupId>
            <artifactId>jing-ffm-processor</artifactId>
            <version>${revision}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- jmh core (runtime) -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>

        <!-- jackson for comparison benchmarks -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                    <enablePreview>true</enablePreview>
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.jingproject</groupId>
                            <artifactId>jing-marshall-processor</artifactId>
                            <version>${revision}</version>
                        </path>
                        <path>
                            <groupId>io.jingproject</groupId>
                            <artifactId>jing-ffm-processor</artifactId>
                            <version>${revision}</version>
                        </path>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.jingproject</groupId>
                <artifactId>jing-maven-plugin</artifactId>
                <version>0.0.1</version>
                <executions>
                    <execution>
                        <id>process-main-providers</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>process-jing-providers</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- to be overwritten -->
                    <finalName>benchmarks</finalName>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/benchmarks.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>